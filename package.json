{
  "name": "shadow-launcher-test-noadmin",
  "version": "1.0.0-test",
  "description": "SHADOW LAUNCHER - Utilitaire d'optimisation Windows pour Shadow Market",
  "main": "main.js",
  "author": "Shadow Market",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis portable --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:installer": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "adm-zip": "^0.5.10"
  },
  "build": {
    "appId": "com.shadowmarket.launcher",
    "productName": "Shadow Launcher",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!Shadow_Scripts/**"
    ],
    "extraResources": [],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "ShadowLauncher-Portable.exe"
    }
  }
}
